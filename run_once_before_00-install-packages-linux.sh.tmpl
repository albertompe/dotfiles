{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -euo pipefail

echo "==> Starting Linux package installation..."

# Initialize package collection array
PACKAGES=()

# 1. Add Common CLI packages
{{ range .packages.common_cli -}}
PACKAGES+=("{{ . }}")
{{ end -}}

# 2. Add Common GUI packages (if not headless)
{{ if not .isHeadless -}}
{{ range .packages.common_gui -}}
PACKAGES+=("{{ . }}")
{{ end -}}
{{ end -}}

# 3. Add OS-specific packages
{{ if or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu") -}}

    {{ range .packages.debian_family.cli -}}
    PACKAGES+=("{{ . }}")
    {{ end -}}
    {{ if not .isHeadless -}}
        {{ range .packages.debian_family.gui -}}
        PACKAGES+=("{{ . }}")
        {{ end -}}
    {{ end -}}

    echo "==> Updating APT repositories and installing packages..."
    sudo apt-get -o DPkg::Lock::Timeout=600 update -y
    if [ ${#PACKAGES[@]} -gt 0 ]; then
        sudo apt-get -o DPkg::Lock::Timeout=600 install -y "${PACKAGES[@]}"
    fi

{{ else if eq .chezmoi.osRelease.id "fedora" -}}

    # Install dnf groups separately; they are not packages and dnf install
    # would treat the name as one.
    {{ range .packages.fedora.groups -}}
    echo "==> Installing Fedora group: {{ . }}..."
    # dnf5 dropped `groupinstall`; `group install` works on both dnf4 and dnf5.
    sudo dnf group install -y "{{ . }}" \
        || sudo dnf groupinstall -y "{{ . }}" \
        || echo "    Warning: could not install group '{{ . }}'; continuing."
    {{ end -}}

    echo "==> Building Fedora package list..."
    {{ range .packages.fedora.cli -}}
    PACKAGES+=("{{ . }}")
    {{ end -}}

    {{ if not .isHeadless -}}
        {{ range .packages.fedora.gui -}}
        PACKAGES+=("{{ . }}")
        {{ end -}}
    {{ end -}}

    # Skip packages already present (dnf5 errors on "already installed") and
    # anything not available in this Fedora release (dnf5 "No match").
    INSTALL_PACKAGES=()
    if [ ${#PACKAGES[@]} -gt 0 ]; then
        for pkg in "${PACKAGES[@]}"; do
            if rpm -q "$pkg" &> /dev/null; then
                echo "==> $pkg already installed, skipping."
            else
                INSTALL_PACKAGES+=("$pkg")
            fi
        done
    fi

    if [ ${#INSTALL_PACKAGES[@]} -gt 0 ]; then
        echo "==> Installing individual packages via DNF..."
        sudo dnf install -y --skip-unavailable "${INSTALL_PACKAGES[@]}"
    else
        echo "==> No additional packages to install via DNF."
    fi

{{ else -}}
    echo "==> Error: Unsupported Linux distribution: {{ .chezmoi.osRelease.id }}"
    exit 1
{{ end -}}

echo "==> Linux package installation completed successfully."
{{ end -}}
