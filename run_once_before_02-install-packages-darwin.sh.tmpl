{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

# Make brew available on PATH for this script
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

if ! command -v brew &> /dev/null; then
    echo "==> Error: brew is not available; cannot install packages." >&2
    exit 1
fi

echo "==> Starting macOS Homebrew package installation..."

# Refresh formulae. Tolerated: a transient network failure here must not abort
# the apply before a single package has been installed.
brew update || echo "    Warning: 'brew update' failed; continuing with the current formulae."

# Taps. The installed list is captured once instead of being piped to grep per
# item: grep -q exits on first match, which SIGPIPEs brew and, under pipefail,
# makes an existing tap look missing.
{{ if hasKey .packages.darwin "taps" -}}
INSTALLED_TAPS="$(brew tap)"
{{ range .packages.darwin.taps -}}
if ! printf '%s\n' "$INSTALLED_TAPS" | grep -qxF '{{ . }}'; then
    echo "Adding brew tap: {{ . }}"
    brew tap '{{ . }}'
fi
{{ end -}}
{{ end -}}

# CLI formulae
{{ range .packages.darwin.brews -}}
if ! brew list '{{ . }}' &>/dev/null; then
    echo "Installing brew formula: {{ . }}"
    # stdin from /dev/null disables brew's interactive dependency prompt
    # (Ask.confirm? skips it when stdin is not a TTY).
    brew install '{{ . }}' < /dev/null
fi
{{ end -}}

# GUI casks (skipped on headless machines)
{{ if not .isHeadless -}}
{{ range .packages.darwin.casks -}}
if ! brew list --cask '{{ . }}' &>/dev/null; then
    echo "Installing brew cask: {{ . }}"
    brew install --cask '{{ . }}' < /dev/null
fi
{{ end -}}
{{ end -}}

echo "==> macOS Homebrew package installation completed successfully."
{{ end -}}
