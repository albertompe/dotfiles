{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

# Asegurar que brew esté disponible en el PATH para este script
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

echo "==> Starting macOS Homebrew package installation..."

# Actualizar fórmulas de Homebrew
brew update

# Añadir Taps
{{ if hasKey .packages.darwin "taps" -}}
{{ range .packages.darwin.taps -}}
if ! brew tap | grep -q "^{{ . }}$"; then
    echo "Adding brew tap: {{ . }}"
    brew tap {{ . }}
fi
{{ end -}}
{{ end -}}

# Instalar fórmulas CLI
{{ range .packages.darwin.brews -}}
if ! brew list {{ . }} &>/dev/null; then
    echo "Installing brew formula: {{ . }}"
    brew install {{ . }}
fi
{{ end -}}

# Instalar Casks GUI (si no es un entorno headless)
{{ if not .isHeadless -}}
{{ range .packages.darwin.casks -}}
if ! brew list --cask {{ . }} &>/dev/null; then
    echo "Installing brew cask: {{ . }}"
    brew install --cask {{ . }}
fi
{{ end -}}
{{ end -}}

echo "==> macOS Homebrew package installation completed successfully."
{{ end -}}
