#!/usr/bin/env bash

set -euo pipefail

{{ if not .enableDefaultMiseTools -}}
echo "==> Skipping default mise tools (enableDefaultMiseTools=false)."
echo "==> Only per-project mise.toml tools will be installed on demand."
exit 0
{{ else -}}

echo "==> Provisioning tools with mise..."

if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    export GITHUB_TOKEN="${GITHUB_TOKEN}"
    echo "==> Using GITHUB_TOKEN for API authentication."
fi

MISE_BIN=""
if [[ -f "$HOME/.local/bin/mise" ]]; then
    MISE_BIN="$HOME/.local/bin/mise"
elif [[ -f "/opt/homebrew/bin/mise" ]]; then
    MISE_BIN="/opt/homebrew/bin/mise"
elif [[ -f "/usr/local/bin/mise" ]]; then
    MISE_BIN="/usr/local/bin/mise"
fi

if [[ -z "$MISE_BIN" ]]; then
    echo "==> Error: mise CLI not found. Skipping tool provisioning." >&2
    exit 1
fi

MISE_CONFIG="$HOME/.config/mise/config.toml"

# This is a run_once_after script, so the dotfiles (including the mise config)
# are already applied. Abort loudly rather than letting mise no-op with its
# misleading "all tools are installed" summary.
if [[ ! -f "$MISE_CONFIG" ]]; then
    echo "==> Error: $MISE_CONFIG not found. mise tools skipped." >&2
    exit 1
fi

# mise auto-loads ~/.config/mise/config.toml and installs every tool listed.
# -v shows per-tool install output so failures are visible.
#
# --yes is defence in depth: config.local.toml sets system_deps = "warn", so
# mise should not ask anything, but any other confirmation prompt would hang an
# unattended `chezmoi apply` indefinitely with no indication of why.
#
# The retry is not redundant with mise's own. mise retries each request three
# times, but its backoff totals roughly 4.5 seconds, so all three attempts land
# inside the same congestion window. The failure this guards against is
# contention rather than a slow link: with several jobs running in parallel and
# a ~1.3GB download in flight, other tools cannot open a connection at all and
# burn their attempts immediately. Retrying once the whole pass has finished is
# what actually helps, because by then the large downloads are done and the
# link is free. `mise install` is idempotent, so the second pass only picks up
# whatever is still missing rather than downloading everything again.
echo "==> Installing all configured tools from $MISE_CONFIG ..."

MISE_INSTALL_ATTEMPTS=2
attempt=1
while true; do
    # Kept inside an `if` on purpose: `set -e` does not fire on a command in a
    # condition, so a first failure does not kill the script before the retry.
    if "$MISE_BIN" install --yes -v; then
        break
    fi

    if [ "$attempt" -ge "$MISE_INSTALL_ATTEMPTS" ]; then
        echo "==> Error: mise install failed after $MISE_INSTALL_ATTEMPTS attempts." >&2
        exit 1
    fi

    echo "==> mise install failed (attempt $attempt/$MISE_INSTALL_ATTEMPTS); retrying in 15s..." >&2
    attempt=$((attempt + 1))
    sleep 15
done

echo "==> mise tools installation completed successfully."
{{ end -}}
