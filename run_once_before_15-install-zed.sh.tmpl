{{ if and (eq .chezmoi.os "linux") (not .isHeadless) -}}
#!/usr/bin/env bash

set -euo pipefail

echo "==> Checking Zed editor installation..."

# Ensure ~/.local/bin exists
mkdir -p "$HOME/.local/bin"
export PATH="$HOME/.local/bin:$PATH"

if ! command -v zed &> /dev/null; then
    echo "==> Installing Zed editor natively via official script..."
    # -L matters here: without it a redirect yields an empty body that sh
    # executes successfully, so nothing is installed and the script reports OK.
    curl -fsSL https://zed.dev/install.sh | sh
else
    echo "==> Zed editor is already installed."
fi

echo "==> Zed installation check completed."
{{ end -}}
