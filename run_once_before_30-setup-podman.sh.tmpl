{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash

set -euo pipefail

echo "==> Configuring Podman..."

REGISTRIES_CONF="/etc/containers/registries.conf"
SEARCH_REGISTRIES='unqualified-search-registries = [{{ range $i, $r := .containers.unqualified_search_registries }}{{ if $i }}, {{ end }}"{{ $r }}"{{ end }}]'

# Bail out cleanly when there is nothing to configure. Without this guard the
# `sed -i` below exits 2 on a missing file and aborts the whole apply.
if ! command -v podman > /dev/null 2>&1; then
    echo "    podman not installed; skipping registry configuration."
elif [ ! -f "$REGISTRIES_CONF" ]; then
    echo "    $REGISTRIES_CONF not found; skipping registry configuration."
elif grep -q "^unqualified-search-registries" "$REGISTRIES_CONF"; then
    echo "    Search registries already configured, skipping."
else
    echo "    Setting unqualified-search-registries in $REGISTRIES_CONF"
    # Replace only the first commented occurrence, so several commented
    # examples cannot produce duplicate keys.
    sudo sed -i '0,/^# *unqualified-search-registries/s/^# *unqualified-search-registries.*/'"$SEARCH_REGISTRIES"'/' "$REGISTRIES_CONF"
    if ! grep -q "^unqualified-search-registries" "$REGISTRIES_CONF"; then
        # Nothing to uncomment: insert before the first TOML table instead of
        # appending, otherwise the key would land inside a trailing
        # [[registry]] block and produce an invalid config.
        if grep -q "^[[:space:]]*\[" "$REGISTRIES_CONF"; then
            sudo sed -i '0,/^[[:space:]]*\[/s//'"$SEARCH_REGISTRIES"'\n\n&/' "$REGISTRIES_CONF"
        else
            echo "$SEARCH_REGISTRIES" | sudo tee -a "$REGISTRIES_CONF" > /dev/null
        fi
    fi
fi

# Enable Podman socket for Docker API compatibility
{{ if .enableContainerServices -}}
if command -v systemctl > /dev/null 2>&1; then
    echo "    Enabling podman.socket..."
    systemctl --user enable --now podman.socket || \
        echo "    Warning: could not enable podman.socket (no active user session/systemd). Continue; start it manually later."
else
    echo "    Warning: systemd not available; skipping podman.socket activation."
fi
{{ end -}}

echo "==> Podman configuration completed."
{{ end -}}
