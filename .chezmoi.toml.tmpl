# ==============================================================================
# .chezmoi.toml.tmpl
# ==============================================================================
# Purpose:
#   Generates the local chezmoi configuration file (~/.config/chezmoi/chezmoi.toml).
#   Determines system state flags (isContainer, isHeadless, enableContainerServices,
#   enableKvm) to dynamically drive template rendering and script execution across
#   environments.
#
# Environment Variable Overrides:
#   You can bypass interactive prompts by setting the following environment
#   variables before running 'chezmoi init':
#
#     CHEZMOI_HEADLESS        Explicitly set headless state ("true"/"1" or "false"/"0").
#     CHEZMOI_MISE_TOOLS      Install the default mise tools from config.toml ("true"/"1" or "false"/"0"). Disable for a bare mise: only per-project mise.toml tools are installed.
#     CHEZMOI_ENABLE_CONTAINER_SERVICES Explicitly enable container services ("true"/"1" or "false"/"0").
#     CHEZMOI_ENABLE_KVM      Explicitly enable KVM/hypervisor setup ("true"/"1" or "false"/"0").
#
# Usage Examples:
#   - Interactive setup:
#       chezmoi init
#   - Automated/Non-interactive deployment (CI/CD / Headless Server):
#       CHEZMOI_HEADLESS=true CHEZMOI_ENABLE_CONTAINER_SERVICES=false CHEZMOI_ENABLE_KVM=false chezmoi init --apply
#   - Minimal/bare mise (no default tools; per-project mise.toml only):
#       CHEZMOI_MISE_TOOLS=false chezmoi init --apply
#   - Re-evaluate configuration from scratch:
#       rm -f ~/.config/chezmoi/chezmoi.toml && chezmoi init
# ==============================================================================
{{- $isContainer := false -}}
{{- if hasKey .chezmoi "isolation" -}}
{{-   $isContainer = eq .chezmoi.isolation "container" -}}
{{- else if (stat "/.dockerenv") -}}
{{-   $isContainer = true -}}
{{- end -}}

{{/* 1. Evaluate isHeadless */}}
{{- $isHeadless := false -}}
{{- $envHeadless := env "CHEZMOI_HEADLESS" -}}

{{- if $isContainer -}}
{{-   $isHeadless = true -}}
{{- else if ne $envHeadless "" -}}
{{-   $isHeadless = (eq $envHeadless "true" "1") -}}
{{- else -}}
{{-   $isHeadless = promptBoolOnce . "isHeadless" "Is this a headless machine (no graphical user interface)?" false -}}
{{- end -}}

{{/* 2. Evaluate enableDefaultMiseTools */}}
{{- $enableDefaultMiseTools := true -}}
{{- $envMiseTools := env "CHEZMOI_MISE_TOOLS" -}}

{{- if ne $envMiseTools "" -}}
{{-   $enableDefaultMiseTools = (eq $envMiseTools "true" "1") -}}
{{- else -}}
{{-   $enableDefaultMiseTools = promptBoolOnce . "enableDefaultMiseTools" "Install the default mise tools (from config.toml)? Disable for a bare mise (per-project mise.toml only)." true -}}
{{- end -}}

{{/* 3. Evaluate enableContainerServices */}}
{{- $enableContainerServices := false -}}
{{- $envServices := env "CHEZMOI_ENABLE_CONTAINER_SERVICES" -}}

{{- if ne $envServices "" -}}
{{-   $enableContainerServices = (eq $envServices "true" "1") -}}
{{- else if $isContainer -}}
{{-   $enableContainerServices = promptBoolOnce . "enableContainerServices" "In a container: enable container services (Docker daemon, Podman socket)? Useful for LXC with systemd." false -}}
{{- else -}}
{{-   $enableContainerServices = promptBoolOnce . "enableContainerServices" "Do you want to enable container services (Docker daemon, Podman socket)?" true -}}
{{- end }}

{{/* 4. Evaluate enableKvm */}}
{{- $enableKvm := true -}}
{{- $envKvm := env "CHEZMOI_ENABLE_KVM" -}}

{{- if $isContainer -}}
{{-   $enableKvm = false -}}
{{- else if ne $envKvm "" -}}
{{-   $enableKvm = (eq $envKvm "true" "1") -}}
{{- else -}}
{{-   $enableKvm = promptBoolOnce . "enableKvm" "Do you want to set up KVM/libvirt (hypervisor and VMs)?" true -}}
{{- end }}

# File mode policy — explicit and independent of the invoking shell's umask
umask = 0o077

# Target Environment State Variables
[data]
    # Indicates if execution is taking place inside a Docker/LXC container
    isContainer = {{ $isContainer }}

    # Indicates if the host lacks a graphical interface (GUI)
    isHeadless = {{ $isHeadless }}

    # Determines if the default mise tools (from config.toml) should be installed.
    # Disabled → bare mise: only per-project mise.toml tools are installed.
    enableDefaultMiseTools = {{ $enableDefaultMiseTools }}

    # Determines if container-related systemd services (Docker daemon, Podman socket) should be started
    enableContainerServices = {{ $enableContainerServices }}

    # Determines if the KVM/libvirt hypervisor and VM management should be set up
    enableKvm = {{ $enableKvm }}
