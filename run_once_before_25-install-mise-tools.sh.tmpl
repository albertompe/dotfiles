#!/usr/bin/env bash

set -euo pipefail

echo "==> Provisioning tools with mise..."

# Inherit and export GITHUB_TOKEN for mise API authentication during installation
if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    export GITHUB_TOKEN="${GITHUB_TOKEN}"
    echo "==> Using GITHUB_TOKEN for API authentication."
fi

# Ensure mise is in PATH
MISE_BIN=""
if [[ -f "$HOME/.local/bin/mise" ]]; then
    MISE_BIN="$HOME/.local/bin/mise"
elif [[ -f "/opt/homebrew/bin/mise" ]]; then
    MISE_BIN="/opt/homebrew/bin/mise"
elif [[ -f "/usr/local/bin/mise" ]]; then
    MISE_BIN="/usr/local/bin/mise"
fi

if [[ -n "$MISE_BIN" ]]; then
    MISE_CONFIG="$HOME/.config/mise/config.toml"

    # mise already loads ~/.config/mise/config.toml as the global config and
    # installs every tool listed in it, so no --config/--path flag is needed.
    # Trust the chezmoi-managed config so nothing is skipped for being untrusted.
    echo "==> Trusting mise config: $MISE_CONFIG ..."
    "$MISE_BIN" trust "$MISE_CONFIG" || true

    echo "==> Installing all configured tools from $MISE_CONFIG ..."
    # -v shows per-tool install output so failures are visible instead of the
    # misleading "all tools are installed" summary.
    "$MISE_BIN" install -v

    echo "==> Verifying installed tools with 'mise ls --installed' ..."
    "$MISE_BIN" ls --installed || true

    echo "==> mise tools installation completed successfully."
else
    echo "==> Error: mise CLI not found in PATH. Skipping tool provisioning."
    exit 1
fi
