#!/usr/bin/env bash

set -euo pipefail

echo "==> Provisioning tools with mise..."

# Inherit and export GITHUB_TOKEN for mise API authentication during installation
if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    export GITHUB_TOKEN="${GITHUB_TOKEN}"
    echo "==> Using GITHUB_TOKEN for API authentication."
fi

# Ensure mise is in PATH
MISE_BIN=""
if [[ -f "$HOME/.local/bin/mise" ]]; then
    MISE_BIN="$HOME/.local/bin/mise"
elif [[ -f "/opt/homebrew/bin/mise" ]]; then
    MISE_BIN="/opt/homebrew/bin/mise"
elif [[ -f "/usr/local/bin/mise" ]]; then
    MISE_BIN="/usr/local/bin/mise"
fi

if [[ -n "$MISE_BIN" ]]; then
    echo "==> Installing all configured tools from ~/.config/mise/config.toml..."
    # Execute mise directly via binary path with explicit config file reference
    "$MISE_BIN" install --config "$HOME/.config/mise/config.toml" -y

    echo "==> mise tools installation completed successfully."
else
    echo "==> Error: mise CLI not found in PATH. Skipping tool provisioning."
    exit 1
fi
