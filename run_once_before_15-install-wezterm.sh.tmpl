{{ if and (eq .chezmoi.os "linux") (not .isHeadless) -}}
#!/usr/bin/env bash

set -euo pipefail

echo "==> Checking WezTerm installation..."

if command -v wezterm &> /dev/null; then
    echo "==> WezTerm is already installed."
else
{{ if or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu") -}}
    echo "==> Installing WezTerm (stable) via community APT repository..."

    echo "==> Adding WezTerm GPG key..."
    curl -fsSL https://apt.fury.io/wez/gpg.key | sudo gpg --yes --dearmor -o /usr/share/keyrings/wezterm-fury.gpg

    echo "==> Adding WezTerm APT repository..."
    echo 'deb [signed-by=/usr/share/keyrings/wezterm-fury.gpg] https://apt.fury.io/wez/ * *' | sudo tee /etc/apt/sources.list.d/wezterm.list
    sudo chmod 644 /usr/share/keyrings/wezterm-fury.gpg

    echo "==> Updating APT repositories and installing WezTerm..."
    sudo apt update -y
    sudo apt install -y wezterm

{{ else if eq .chezmoi.osRelease.id "fedora" -}}
    echo "==> Installing WezTerm (nightly) via COPR..."

    echo "==> Enabling WezTerm COPR repository..."
    sudo dnf copr enable --assumeyes wezfurlong/wezterm-nightly

    echo "==> Installing WezTerm via DNF..."
    sudo dnf install -y wezterm

{{ else -}}
    echo "==> Error: WezTerm installation is not supported on {{ .chezmoi.osRelease.id }}."
    exit 1
{{ end -}}
fi

echo "==> WezTerm installation check completed."
{{ end -}}
