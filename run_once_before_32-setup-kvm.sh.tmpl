{{ if and (eq .chezmoi.os "linux") (not .isContainer) .enableKvm -}}
#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -euo pipefail

echo "==> Setting up KVM/libvirt (hypervisor and VMs)..."

# Collect KVM packages
KVM_PACKAGES=()

{{ if or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu") -}}

{{ range .packages.debian.kvm_cli -}}
KVM_PACKAGES+=("{{ . }}")
{{ end -}}
{{ if not .isHeadless -}}
{{ range .packages.debian.kvm_gui -}}
KVM_PACKAGES+=("{{ . }}")
{{ end -}}
{{ end -}}

echo "==> Installing KVM packages via APT..."
sudo apt-get -o DPkg::Lock::Timeout=600 update -y
sudo apt-get -o DPkg::Lock::Timeout=600 install -y "${KVM_PACKAGES[@]}"

# Add user to libvirt groups
KVM_GROUPS=("libvirt" "kvm" "libvirt-qemu")
for grp in "${KVM_GROUPS[@]}"; do
    if ! getent group "$grp" > /dev/null 2>&1; then
        echo "    Creating group $grp..."
        sudo groupadd "$grp"
    fi
done
echo "    Adding $USER to groups: ${KVM_GROUPS[*]}"
sudo usermod -aG "$(IFS=,; echo "${KVM_GROUPS[*]}")" "$USER"

# Verify KVM is available
echo "==> Checking KVM availability..."
if [[ -e /dev/kvm ]]; then
    echo "    KVM is available (/dev/kvm present)."
else
    echo "    Warning: /dev/kvm not found. Hardware acceleration unavailable."
fi
kvm-ok 2>/dev/null || true

{{ else if eq .chezmoi.osRelease.id "fedora" -}}

{{ range .packages.fedora.kvm_cli -}}
KVM_PACKAGES+=("{{ . }}")
{{ end -}}
{{ if not .isHeadless -}}
{{ range .packages.fedora.kvm_gui -}}
KVM_PACKAGES+=("{{ . }}")
{{ end -}}
{{ end -}}

echo "==> Installing KVM packages via DNF..."
# Skip packages already present (dnf5 errors on "already installed") and
# anything not available in this release (dnf5 "No match").
INSTALL_PACKAGES=()
for pkg in "${KVM_PACKAGES[@]}"; do
    if rpm -q "$pkg" &> /dev/null; then
        echo "    $pkg already installed, skipping."
    else
        INSTALL_PACKAGES+=("$pkg")
    fi
done

if [ ${#INSTALL_PACKAGES[@]} -gt 0 ]; then
    sudo dnf install -y --skip-unavailable "${INSTALL_PACKAGES[@]}"
else
    echo "    No additional KVM packages to install via DNF."
fi

# Add user to libvirt groups
KVM_GROUPS=("libvirt" "qemu")
for grp in "${KVM_GROUPS[@]}"; do
    if ! getent group "$grp" > /dev/null 2>&1; then
        echo "    Creating group $grp..."
        sudo groupadd "$grp"
    fi
done
echo "    Adding $USER to groups: ${KVM_GROUPS[*]}"
sudo usermod -aG "$(IFS=,; echo "${KVM_GROUPS[*]}")" "$USER"

{{ else -}}

echo "==> Error: Unsupported Linux distribution: {{ .chezmoi.osRelease.id }}"
exit 1

{{ end -}}

# Start libvirtd if systemd is available
if command -v systemctl > /dev/null 2>&1; then
    echo "==> Enabling and starting libvirtd..."
    sudo systemctl enable --now libvirtd || true
fi

# Note: user needs to re-login for group membership changes to take effect
echo "    NOTE: Re-login (or 'newgrp libvirt') required for group changes to apply."

# Verify libvirt is responding
echo "==> Verifying libvirt..."
sudo virsh list --all 2>/dev/null || virsh list --all 2>/dev/null || echo "    virsh failed to connect; check that libvirtd is running."

echo "==> KVM/libvirt setup completed."
{{ end -}}
