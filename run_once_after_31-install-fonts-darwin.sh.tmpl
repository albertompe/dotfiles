{{ if and (eq .chezmoi.os "darwin") (not .isHeadless) -}}
#!/usr/bin/env bash

set -euo pipefail

# On macOS ~/.fonts is a fontconfig path that CoreText ignores, so wezterm and
# other apps never see the deployed MesloLGS NF. User fonts must live in
# ~/Library/Fonts to be picked up by the system font books.
echo "==> Installing fonts for macOS..."

if [ -d "$HOME/.fonts" ]; then
    mkdir -p "$HOME/Library/Fonts"
    cp -n "$HOME/.fonts/"*.ttf "$HOME/Library/Fonts/" 2>/dev/null || true
    cp -n "$HOME/.fonts/"*.otf "$HOME/Library/Fonts/" 2>/dev/null || true
    echo "    Copied fonts to $HOME/Library/Fonts."
else
    echo "    No ~/.fonts directory; nothing to install."
fi

echo "==> Font install completed."
{{ end -}}