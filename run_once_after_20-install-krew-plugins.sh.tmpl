#!/usr/bin/env bash

set -euo pipefail

KREW_BIN=""
if command -v krew &>/dev/null; then
    KREW_BIN="$(command -v krew)"
elif [[ -x "$HOME/.local/share/mise/shims/krew" ]]; then
    KREW_BIN="$HOME/.local/share/mise/shims/krew"
elif [[ -x "/opt/homebrew/bin/krew" ]]; then
    KREW_BIN="/opt/homebrew/bin/krew"
elif [[ -x "/usr/local/bin/krew" ]]; then
    KREW_BIN="/usr/local/bin/krew"
fi

if [[ -z "$KREW_BIN" ]]; then
    echo "==> krew CLI not found. Skipping krew plugin installation." >&2
    exit 0
fi

KREW_PLUGINS=()
{{ range .krew.common_plugins -}}
KREW_PLUGINS+=("{{ . }}")
{{ end -}}
{{ if eq .chezmoi.os "linux" -}}
{{ range .krew.linux_plugins -}}
KREW_PLUGINS+=("{{ . }}")
{{ end -}}
{{ else if eq .chezmoi.os "darwin" -}}
{{ range .krew.darwin_plugins -}}
KREW_PLUGINS+=("{{ . }}")
{{ end -}}
{{ end -}}

if [ ${#KREW_PLUGINS[@]} -eq 0 ]; then
    echo "==> No krew plugins configured; nothing to do."
    exit 0
fi

echo "==> Installing krew plugins..."

# `krew list` is captured once instead of being piped to grep inside the loop:
# `grep -q` exits on the first match, which sends SIGPIPE to krew, and with
# `pipefail` the pipeline then reports failure, making an installed plugin look
# missing and turning the redundant `krew install` into a fatal error.
INSTALLED_PLUGINS="$("$KREW_BIN" list 2>/dev/null || true)"

for plugin in "${KREW_PLUGINS[@]}"; do
    if printf '%s\n' "$INSTALLED_PLUGINS" | grep -qx "$plugin"; then
        echo "--> $plugin is already installed."
    else
        echo "--> Installing $plugin..."
        "$KREW_BIN" install "$plugin"
    fi
done

echo "==> krew plugins installation completed successfully."
